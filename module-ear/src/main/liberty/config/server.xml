<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<server description="new server">
	<!-- Enable features -->
	<!--The Liberty Maven Plugin has generated Liberty features necessary for your application in configDropins/overrides/generated-features.xml-->
	<featureManager>
		<!-- jsfContainer-2.2 and jsp-2.3 removed - using custom Mojarra JSF+EL implementation from WAR -->
		<feature>servlet-3.1</feature>
		<feature>ejb-3.2</feature>
		<feature>jaxrs-2.0</feature>
		<feature>json-1.0</feature>
		<feature>jsonp-1.0</feature>

		<feature>jaxb-2.2</feature>
		<feature>appSecurity-2.0</feature>
		<feature>jwt-1.0</feature>
		<feature>localConnector-1.0</feature>
		<feature>restConnector-2.0</feature>
		<feature>mpConfig-1.3</feature>
		<feature>cdi-1.2</feature>
		<feature>bells-1.0</feature>
	</featureManager>

	<!-- use a different port than twas-->
	<variable name="http.port" defaultValue="9091"/>
	<variable name="https.port" defaultValue="9444"/>

	<variable name="artifactId" defaultValue="application-ear-1.0-SNAPSHOT"/>	
  	<variable name="password/ssl" defaultValue="changeit"/>
  	<variable name="password/ltpa" defaultValue="${password/ssl}"/>

<iiopEndpoint id="defaultIiopEndpoint" iiopPort="2810">
   <iiopsOptions iiopsPort="9404" sslRef="defaultSSLConfig"/>
</iiopEndpoint>

  <!-- Automatically expand WAR files and EAR files -->
  <applicationManager autoExpand="false"/>

	<!--set in pom.xml otherwise use default-->
	<include location="security.xml" onConflict="merge"/>
	<httpEndpoint httpPort="${http.port}" httpsPort="${https.port}" id="defaultHttpEndpoint" host="*"/>
	
	<!-- Disable HTTP session cookies to use JWT-only authentication -->
	<httpSession cookiesEnabled="true"/>
	
	<library id="was_orb_lib" filesetDir="/opt/IBM/WebSphere/AppServer/runtimes" includes="com.ibm.ws.orb_9.0.jar com.ibm.ws.admin.client_9.0.jar"/>
	<library id="api-lib" filesetDir="lib" includes="api-1.0-SNAPSHOT.jar"/>
	<library id="util-lib" filesetDir="lib" includes="util-1.0-SNAPSHOT.jar"/>

	<enterpriseApplication location="${artifactId}.ear">
		<bells>
			<api>
				<library id="api-lib"/>
			</api>
			<implementation>
				<library id="util-lib"/>
				<library id="was_orb_lib"/>
			</implementation>
		</bells>

<application-bnd>
	  <security-role name="master">
          <group access-id="master" />
      </security-role>

	  <security-role name="webuser">
          <special-subject type="ALL_AUTHENTICATED_USERS" />
      </security-role>
</application-bnd> 


	</enterpriseApplication>

  <remoteFileAccess>
      <writeDir>${server.config.dir}/dropins</writeDir>
  </remoteFileAccess>

</server>
